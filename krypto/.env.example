# Kopieren nach .env und ausfüllen. .env NIE committen!

# Privater Schlüssel des Deploy-Wallets. Für das Testnetz ein reines Test-Wallet.
# Für das Mainnet ein frisches Wallet, das nach dem Deployment nichts mehr hält.
PRIVATE_KEY=

# RPC-Endpunkte (öffentliche Standardwerte funktionieren, sind aber gedrosselt;
# besser eigene von Alchemy, Infura oder QuickNode)
BASE_SEPOLIA_RPC_URL=
BASE_RPC_URL=

# Etherscan-API-Schlüssel (v2, gilt auch für Basescan) für die Verifizierung
ETHERSCAN_API_KEY=

# Empfänger – im Mainnet Pflicht, idealerweise Safe-Multisigs (https://app.safe.global)
TEAM_ADDRESS=
PARTNERS_ADDRESS=
LIQUIDITY_ADDRESS=
FOUNDATION_ADDRESS=

# Optional: Start des Vestings als Unix-Zeit (Standard: Zeitpunkt des Deployments)
VESTING_START=

# Erst nach abgearbeiteter Checkliste (docs/GO-LIVE.md) auf "ja" setzen
CONFIRM_MAINNET=
