# Kopieren nach .env und ausfüllen. .env NIE committen!
# RPC-Endpunkt für Sepolia (z. B. von Alchemy oder Infura)
SEPOLIA_RPC_URL=
# Privater Schlüssel eines REINEN TEST-Wallets (niemals das Hauptwallet!)
PRIVATE_KEY=
# Optional: für die Verifizierung auf Etherscan
ETHERSCAN_API_KEY=

# Token-Parameter (ganze Token, nicht Wei)
TOKEN_NAME=Eigen Token
TOKEN_SYMBOL=EIGEN
TOKEN_CAP=21000000
TOKEN_INITIAL_SUPPLY=1000000
